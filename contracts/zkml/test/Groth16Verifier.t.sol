pragma solidity ^0.8.20;

import {Test} from "forge-std/Test.sol";
import {Groth16Verifier} from "../src/Groth16Verifier.sol";

/*
 * The verifier, against a proof that was actually produced.
 *
 * The fixture below is not hand-written: it is the calldata snarkjs emitted
 * for a real proof over a real row of the UCI test set, generated by
 * `scripts/labs/zkml-fixture.mjs`. That matters, because a verifier tested
 * only against proofs it accepts would pass just as happily if it accepted
 * everything -- so the negative cases below are the substance of this file.
 *
 * `verifyProof` is a pure function of the verification key baked into the
 * contract at export time. If the ceremony is re-run, this fixture stops
 * verifying and this test fails, which is exactly what should happen: the
 * deployed verifier and the shipped zkey have to come from the same ceremony.
 */
contract Groth16VerifierTest is Test {
    Groth16Verifier internal verifier;

    uint256[2] internal pA;
    uint256[2][2] internal pB;
    uint256[2] internal pC;
    uint256[6] internal pubSignals;

    function setUp() public {
        verifier = new Groth16Verifier();
        _loadFixture();
    }

    function test_AcceptsARealProof() public view {
        assertTrue(verifier.verifyProof(pA, pB, pC, pubSignals), "a real proof must verify");
    }

    function test_RejectsATamperedPublicSignal() public view {
        // The "Tamper" button in the lab does exactly this: flips a public
        // signal and shows the verification fail, on-chain as well as locally.
        uint256[6] memory tampered = pubSignals;
        tampered[2] = tampered[2] + 1; // the prediction
        assertFalse(verifier.verifyProof(pA, pB, pC, tampered), "a changed prediction must fail");
    }

    function test_RejectsATamperedCommitment() public view {
        uint256[6] memory tampered = pubSignals;
        tampered[0] = tampered[0] + 1; // the model commitment
        assertFalse(
            verifier.verifyProof(pA, pB, pC, tampered),
            "swapping the model commitment must fail: that binding is the whole point"
        );
    }

    function test_RejectsATamperedProof() public view {
        uint256[2] memory badA = pA;
        badA[0] = badA[0] + 1;
        assertFalse(verifier.verifyProof(badA, pB, pC, pubSignals), "a mangled proof must fail");
    }

    function test_RejectsAZeroProof() public view {
        uint256[2] memory zeroA;
        uint256[2][2] memory zeroB;
        uint256[2] memory zeroC;
        assertFalse(
            verifier.verifyProof(zeroA, zeroB, zeroC, pubSignals),
            "an all-zero proof must fail rather than revert into a pass"
        );
    }

    function test_GasIsWhatTheLabReports() public {
        // The lab shows a real eth_estimateGas and its USD cost. This records
        // the figure the verifier actually costs, so a change shows up here
        // rather than on the page.
        uint256 before = gasleft();
        verifier.verifyProof(pA, pB, pC, pubSignals);
        uint256 used = before - gasleft();
        emit log_named_uint("verifyProof gas", used);
        assertLt(used, 300000, "a Groth16 verify should be far under 300k gas");
    }

    function _loadFixture() internal {
        string memory json = vm.readFile("test/fixture.json");
        uint256[] memory a = vm.parseJsonUintArray(json, ".pA");
        uint256[] memory c = vm.parseJsonUintArray(json, ".pC");
        uint256[] memory b0 = vm.parseJsonUintArray(json, ".pB0");
        uint256[] memory b1 = vm.parseJsonUintArray(json, ".pB1");
        uint256[] memory pub = vm.parseJsonUintArray(json, ".pubSignals");

        pA = [a[0], a[1]];
        pB = [[b0[0], b0[1]], [b1[0], b1[1]]];
        pC = [c[0], c[1]];
        for (uint256 i = 0; i < 6; i++) {
            pubSignals[i] = pub[i];
        }
    }
}
